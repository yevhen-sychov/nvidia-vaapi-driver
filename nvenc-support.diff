+            TEST_PASS();
+        } else {
+            TEST_FAIL(has ? "unexpected VLD" : "missing VLD");
+        }
+    }
+}
+
+/* --- Config attribute validation --- */
+
+static void test_config_rtformat(void) {
+    TEST_START("H264 High RTFormat includes YUV420");
